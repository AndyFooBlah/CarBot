# Firebase configuration
# Get these from your Firebase project settings → General → Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Gemini API key
# Get from: https://aistudio.google.com
VITE_GEMINI_API_KEY=

# NOTE: The Google Maps API key is NOT configured on the client. Maps and
# Weather tools route through the server-side geoProxy callable function,
# which reads GOOGLE_MAPS_API_KEY from Firebase Secret Manager.
# Set up via:  firebase functions:secrets:set GOOGLE_MAPS_API_KEY
