# Dependencies
node_modules/
functions/node_modules/

# Build output
dist/
functions/lib/

# Environment (never commit real credentials)
.env
.env.local
.env.production
# Exception: functions/.env is committed. It holds only non-secret function
# config (the EMAIL_FEATURES_ENABLED switch) that the non-interactive CI
# deploy and the web build both read. Secrets go in Secret Manager, never here.
!functions/.env

# Firebase local state
.firebase/
firebase-debug.log
firestore-debug.log
storage.rules.debug.log

# Editor
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Test coverage
coverage/
