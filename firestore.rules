rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------------
    // Helper functions
    // ---------------------------------------------------------------------------

    /** True if the caller is authenticated. */
    function isAuth() {
      return request.auth != null;
    }

    /** True if the caller's uid matches the given userId. */
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    /** True if a field is present in the incoming data. */
    function has(field) {
      return field in request.resource.data;
    }

    /** True if the userId field in the incoming data matches the caller. */
    function incomingUserIdMatches() {
      return has('userId') && request.resource.data.userId == request.auth.uid;
    }

    // ---------------------------------------------------------------------------
    // User profiles
    // ---------------------------------------------------------------------------

    match /users/{userId} {
      allow read, create: if isOwner(userId);
      // audioRetentionDays, when present, must be one of the supported
      // windows (null = keep forever). Enforced by the nightly job (#34).
      allow update: if isOwner(userId)
        && (
          !has('audioRetentionDays')
          || request.resource.data.audioRetentionDays == null
          || request.resource.data.audioRetentionDays in [30, 90, 365]
        );
      // Profile deletion goes through the deleteAccount callable, which also
      // removes sessions, audio, memories, docs and the Auth user (#34).
      allow delete: if false;
    }

    // ---------------------------------------------------------------------------
    // Sessions
    // ---------------------------------------------------------------------------

    // Users can only access their own sessions.
    match /sessions/{sessionId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      // Create: exactly the fields VoiceCommon's createSession writes —
      // no client-invented fields at document birth (#28).
      allow create: if isAuth() && incomingUserIdMatches()
        && request.resource.data.keys().hasOnly(
          ['userId', 'startTime', 'endTime', 'audioUrl', 'status',
           'durationSeconds']);
      // Update: owner only, and only the fields the sanctioned client
      // writers touch — VoiceCommon finalizeSession (endTime, status,
      // durationSeconds, audioUrl), VoiceCommon's metrics write
      // (sessionMetrics), and CarBot setSessionCarbotFields (tripContext,
      // contextDocIds, summary). Everything else — including userId, so a
      // session can never be reassigned to another user — is frozen (#28).
      // status is limited to known values when present.
      allow update: if isAuth()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['status', 'endTime', 'durationSeconds', 'audioUrl',
           'sessionMetrics', 'tripContext', 'contextDocIds', 'summary'])
        && (
          !has('status') ||
          request.resource.data.status in ['completed', 'interrupted', 'active']
        );
      // Deletion goes through the deleteSession callable so subcollections,
      // fanned-out memories and the Storage recording are removed together
      // instead of being orphaned by a bare document delete (#34).
      allow delete: if false;

      // Raw transcript written by the client in real-time during a session.
      match /transcript/{docId} {
        allow read, write: if isAuth()
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.userId == request.auth.uid;
      }

      // Transcript edits written by the client
      match /transcriptEdits/{editId} {
        allow read: if isAuth()
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.userId == request.auth.uid;
        allow create: if isAuth()
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.userId == request.auth.uid
          && request.resource.data.keys().hasAll(['type', 'entries', 'editedAt'])
          && request.resource.data.type in ['entries', 'clean'];
        // Edits are immutable — no updates or deletes from the client.
        allow update, delete: if false;
      }

      // Session-level memory facts (written by Cloud Functions only)
      match /memories/{docId} {
        allow read: if isAuth()
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.userId == request.auth.uid;
        allow write: if false;
      }
    }

    // ---------------------------------------------------------------------------
    // Cross-session memory index
    // ---------------------------------------------------------------------------

    match /memories/{memoryId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      // Clients may update their own memories (e.g. to mark edited=true)
      // but cannot change the userId, sessionId, or createdAt.
      allow update: if isAuth()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.sessionId == resource.data.sessionId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
      // Memories are created by Cloud Functions only.
      allow create: if false;
    }

    // ---------------------------------------------------------------------------
    // Context documents
    // ---------------------------------------------------------------------------

    match /context_documents/{docId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth()
        && incomingUserIdMatches()
        && request.resource.data.keys().hasAll(['userId', 'title', 'source', 'content', 'active', 'createdAt', 'updatedAt'])
        && request.resource.data.source in ['upload', 'email', 'text'];
      allow update: if isAuth()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // ---------------------------------------------------------------------------
    // Ingested emails
    // ---------------------------------------------------------------------------

    // Emails are written exclusively by Cloud Functions.
    // Users can read (not write) their own emails.
    match /emails/{emailId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ---------------------------------------------------------------------------
    // Wikipedia article cache (shared across all users, not user-scoped)
    // ---------------------------------------------------------------------------

    // Reads are open (public Wikipedia content, shared cache). Writes are
    // denied here and happen only through the `cacheWikipediaArticle`
    // Cloud Function which fetches server-side before writing. Prevents
    // cache-poisoning (SECURITY_REVIEW H2).
    match /wikipedia_cache/{articleId} {
      allow read: if isAuth();
      allow write: if false;

      match /chunks/{chunkIndex} {
        allow read: if isAuth();
        allow write: if false;
      }
    }

    // ---------------------------------------------------------------------------
    // System / internal documents
    // ---------------------------------------------------------------------------

    // The Gmail polling state document is internal — no client access.
    match /system/{docId} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------------------
    // Per-user voice quota counters (internal — Cloud Functions only)
    // ---------------------------------------------------------------------------
    //
    // Written exclusively by the voiceQuota callables via the admin SDK. Clients
    // must never read or write these — exposing them would let a user see or
    // reset their own daily cap. Firestore's default-deny would already block
    // access (no other rule matches `_usage/...`), but we set it explicitly so
    // the intent is visible in the rules file.
    match /_usage/{uid}/{document=**} {
      allow read, write: if false;
    }

  }
}
