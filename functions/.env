# Cloud Functions configuration — COMMITTED, NON-SECRET VALUES ONLY.
# Secrets (API keys, OAuth tokens) never go here: use
# `firebase functions:secrets:set NAME` (Secret Manager). This repo is public.
#
# EMAIL_FEATURES_ENABLED — the single switch for all CarBot email features
# (Gmail inbox ingestion, session recap emails, and the email UI in the web
# app, which reads this file at build time). Off by owner decision since
# 2026-11-15; see README "Email (currently disabled)" for how to re-enable.
EMAIL_FEATURES_ENABLED=false
