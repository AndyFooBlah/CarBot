rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ---------------------------------------------------------------------------
    // Session audio files
    //
    // Path: sessions/{userId}/{sessionId}.webm
    //
    // Only the owning user can read or write their session audio.
    // Maximum file size: 500 MB (a 2-hour session at high quality).
    // Only WebM audio files are accepted (VoiceCommon records in WebM/Opus).
    // ---------------------------------------------------------------------------

    match /sessions/{userId}/{fileName} {
      allow read: if request.auth != null
        && request.auth.uid == userId
        && fileName.matches('.*\\.webm');
      allow write: if request.auth != null
        && request.auth.uid == userId
        && fileName.matches('.*\\.webm')
        && request.resource.size < 500 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
    }

    // ---------------------------------------------------------------------------
    // Deny everything else
    // ---------------------------------------------------------------------------

    match /{allPaths=**} {
      allow read, write: if false;
    }

  }
}
